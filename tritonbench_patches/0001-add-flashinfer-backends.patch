+    @register_benchmark(enabled=HAS_FLASHINFER)
+    def flashinfer_fused_add_rmsnorm(
+        self,
+        x: torch.Tensor,
+        residual: torch.Tensor,
+        weight: torch.Tensor,
+    ) -> Callable:
+        # https://docs.flashinfer.ai/generated/flashinfer.norm.fused_add_rmsnorm.html
+        # In place: residual += x; x = rmsnorm(residual) * weight.
+        # Run on private copies so other backends see the original inputs.
+        # Note: it also writes `residual`, i.e. one more M*H write than the
+        # gbps metric below counts, so its reported gbps is conservative.
+        x_buf, r_buf = x.clone(), residual.clone()
+        eps = self.eps
+
+        def fn():
+            flashinfer.fused_add_rmsnorm(x_buf, r_buf, weight, eps)
+            return x_buf
+
+        return fn
+
     @register_metric()
     def gbps(
         self, fn_name: str, example_inputs: Tuple, metrics: BenchmarkOperatorMetrics
